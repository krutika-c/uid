import 'package:flutter/material.dart';


void main() {
 runApp(MyApp());
}


class MyApp extends StatelessWidget {
 @override
 Widget build(BuildContext context) {
   return MaterialApp(
     home: ResponsivePage(),
   );
 }
}


class ResponsivePage extends StatelessWidget {
 @override
 Widget build(BuildContext context) {
   return Scaffold(
     appBar: AppBar(title: Text('Simple Responsive UI-24WH1A05L5')),
     body: LayoutBuilder(
       builder: (context, constraints) {
         if (constraints.maxWidth < 600) {
           // Small screen: center Column layout
           return Center(
             child: Column(
               mainAxisSize: MainAxisSize.min,
               children: [
                 Container(
                   height: 300,
                   width: 200,
                   child: Image.asset('assets/p2.png'),
                 ),
                 Container(
                   height: 280,
                   width: 200,
                   child: Image.asset('assets/photo1.png'),
                 ),
               ],
             ),
           );
         } else {
           // Large screen: center Row layout
           return Center(
             child: Row(
               mainAxisSize: MainAxisSize.min,
               children: [
                 Container(
                   height: 500,
                   width: 300,
                   child: Image.asset('assets/p2.png'),
                 ),
                 Container(
                   height: 750,
                   width: 300,
                   child: Image.asset('assets/photo1.png'),
                 ),
               ],
             ),
           );
         }
       },
     ),
   );
 }
}
