import 'package:flutter/material.dart';


void main() {
runApp(const MyApp());
}


class MyApp extends StatelessWidget {
const MyApp({super.key});


@override
Widget build(BuildContext context) {
 return MaterialApp(
  title: 'Navigation with Named Routes',
  initialRoute: '/', // Starting screen
  routes: {
   '/': (context) => const FirstRoute(), // First route (home)
   '/second': (context) => const SecondRoute(), // Second route
   '/third': (context) => const ThirdRoute(), // Third route
  },


 );
}
}


// FirstRoute (Home Screen)
class FirstRoute extends StatelessWidget {
const FirstRoute({super.key});


@override
Widget build(BuildContext context) {
 return Scaffold(


   appBar: AppBar(
    title: const Text('First Route-24WH1A05L5'),
    backgroundColor: Colors.blue,
   ),
  body: Center(
   child: ElevatedButton(
    child: const Text('Go to Second Route'),
    onPressed: () {
     // Navigate to the second route using the name
     Navigator.pushNamed(context, '/second');
   },
   ),
  ),
 );
}
}


// SecondRoute
class SecondRoute extends StatelessWidget {
const SecondRoute({super.key});


@override
Widget build(BuildContext context) {
 return Scaffold(
  appBar: AppBar(
   title: const Text('Second Route-24WH1A05L5'),
   backgroundColor: Colors.green,
  ),
  body: Center(
   child: ElevatedButton(
   child: const Text('Go to Third Route'),
   onPressed: () {
    // Navigate to the third route using the name
    Navigator.pushNamed(context, '/third');
   },
   ),
  ),
 );
}
}


// ThirdRoute
class ThirdRoute extends StatelessWidget {
const ThirdRoute({super.key});


@override
Widget build(BuildContext context) {
  return Scaffold(
   appBar: AppBar(
    title: const Text('Third Route-24WH1A05L5'),
    backgroundColor: Colors.orange,
   ),
   body: Center(
    child: ElevatedButton(
     child: const Text('Go Back to First Route'),
     onPressed: () {
// Go back to the first route using the Navigator
     Navigator.popUntil(context, ModalRoute.withName('/'));
    },
   ),
  ),
 );
}
}
