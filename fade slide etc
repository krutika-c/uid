
import 'package:flutter/material.dart';

void main()
{
  runApp(const MyApp());
}

class MyApp extends StatelessWidget
{
  const MyApp({super.key});

  @override
  Widget build(BuildContext context)
  {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Animation Lab',
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.deepPurple,
        ),
      ),
      home: const AnimationPage(),
    );
  }
}

class AnimationPage extends StatefulWidget
{
  const AnimationPage({super.key});

  @override
  State<AnimationPage> createState() => _AnimationPageState();
}

class _AnimationPageState extends State<AnimationPage>
{
  bool size = false;
  bool fade = false;
  bool slide = false;
  bool rotate = false;
  bool scale = false;

  void resetAnimation()
  {
    setState(() {
      size = false;
      fade = false;
      slide = false;
      rotate = false;
      scale = false;
    });
  }

  @override
  Widget build(BuildContext context)
  {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Animation Lab'),
        centerTitle: true,
      ),

      body: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.all(20),

          child: Column(
            children: [
              const Text(
                'Flutter Animation Playground',
                style: TextStyle(
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 10),

              const Text(
                'Choose an animation',
                style: TextStyle(
                  fontSize: 16,
                ),
              ),

              const SizedBox(height: 35),

              // Animated Object
              AnimatedSlide(
                offset: slide
                    ? const Offset(0.8, 0)
                    : Offset.zero,
                duration: const Duration(milliseconds: 700),
                curve: Curves.easeInOut,

                child: AnimatedOpacity(
                  opacity: fade ? 0.2 : 1.0,
                  duration: const Duration(milliseconds: 700),

                  child: AnimatedScale(
                    scale: scale ? 1.5 : 1.0,
                    duration: const Duration(milliseconds: 700),
                    curve: Curves.easeInOut,

                    child: AnimatedRotation(
                      turns: rotate ? 0.5 : 0,
                      duration: const Duration(milliseconds: 700),

                      child: AnimatedContainer(
                        duration: const Duration(milliseconds: 700),
                        curve: Curves.easeInOut,

                        width: size ? 220 : 140,
                        height: size ? 180 : 140,

                        decoration: BoxDecoration(
                          color: size
                              ? Colors.deepPurple
                              : Colors.blue,
                          borderRadius: BorderRadius.circular(
                            size ? 40 : 15,
                          ),
                          boxShadow: const [
                            BoxShadow(
                              blurRadius: 12,
                              offset: Offset(0, 6),
                            ),
                          ],
                        ),

                        child: const Center(
                          child: Icon(
                            Icons.star,
                            color: Colors.white,
                            size: 60,
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              ),

              const SizedBox(height: 45),

              // Animation Buttons
              Wrap(
                spacing: 12,
                runSpacing: 12,
                alignment: WrapAlignment.center,
                children: [

                  ElevatedButton.icon(
                    onPressed: () {
                      setState(() {
                        size = !size;
                      });
                    },
                    icon: const Icon(Icons.open_in_full),
                    label: const Text('Size'),
                  ),

                  ElevatedButton.icon(
                    onPressed: () {
                      setState(() {
                        fade = !fade;
                      });
                    },
                    icon: const Icon(Icons.visibility),
                    label: const Text('Fade'),
                  ),

                  ElevatedButton.icon(
                    onPressed: () {
                      setState(() {
                        slide = !slide;
                      });
                    },
                    icon: const Icon(Icons.swap_horiz),
                    label: const Text('Slide'),
                  ),

                  ElevatedButton.icon(
                    onPressed: () {
                      setState(() {
                        rotate = !rotate;
                      });
                    },
                    icon: const Icon(Icons.rotate_right),
                    label: const Text('Rotate'),
                  ),

                  ElevatedButton.icon(
                    onPressed: () {
                      setState(() {
                        scale = !scale;
                      });
                    },
                    icon: const Icon(Icons.zoom_in),
                    label: const Text('Scale'),
                  ),

                  OutlinedButton.icon(
                    onPressed: resetAnimation,
                    icon: const Icon(Icons.refresh),
                    label: const Text('Reset'),
                  ),
                ],
              ),

              const SizedBox(height: 35),

              const Text(
                'Roll No: 24WH1A05L5',
                style: TextStyle(
                  fontWeight: FontWeight.bold,
                  fontSize: 16,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
